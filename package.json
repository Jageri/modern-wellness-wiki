{
  "name": "modern-wellness-wiki",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:index": "node scripts/reader-index.mjs",
    "docs:index:check": "node scripts/reader-index.mjs --check",
    "docs:prepare": "node scripts/prepare-site.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev",
    "docs:build": "npm run docs:prepare && vitepress build",
    "docs:check": "node scripts/check-site-seo.mjs",
    "docs:preview": "vitepress preview",
    "content:check": "node scripts/check-content.mjs",
    "content:reviews": "node scripts/check-content.mjs --strict-reviews",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run docs:index:check && npm run content:reviews && npm run docs:build && npm run docs:check"
  },
  "devDependencies": {
    "markdown-it-footnote": "^4.0.0",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}
